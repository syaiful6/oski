opam-version: "2.0"
synopsis: "ocaml binding to SKIA"
description: "oski is Ocaml binding to SKIA"
maintainer: ["Syaiful Bahri <syai.bahri6@gmail.com>"]
authors: ["Syaiful Bahri <syai.bahri6@gmail.com>"]
license: "LICENCE"
tags: ["skia" "your" "project"]
homepage: "https://github.com/syaiful6/oski"
doc: "https://url/to/documentation"
bug-reports: "https://github.com/syaiful6/oski/issues"
depends: [
  "ocaml"
  "dune" {>= "3.19"}
  "ctypes" {>= "0.14.0"}
  "alcotest" {with-test}
  "dune-site" {with-test}
  "ocaml-lsp-server" {with-dev-setup}
  "dot-merlin-reader" {with-dev-setup}
  "ocamlformat" {with-dev-setup}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/syaiful6/oski.git"
x-maintenance-intent: ["(latest)"]
