(rule
 (targets os.txt)
 (action
  (with-stdout-to
   %{targets}
   (run sh -c "uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/mac/'"))))

(rule
 (targets arch.txt)
 (action
  (with-stdout-to
   %{targets}
   (run sh -c "uname -m | sed 's/x86_64/x64/;s/arm64/arm64/'"))))

(rule
 (targets lib_ext.txt)
 (deps os.txt)
 (action
  (with-stdout-to
   %{targets}
   (run
    sh
    -c
    "if [ $(cat os.txt) = windows ]; then echo lib; else echo a; fi"))))

(rule
 (targets
  (dir prefix))
 (deps
  (source_tree skia)
  os.txt
  arch.txt
  lib_ext.txt
  ../config/gn_args.txt
  scripts/build-vendor.sh)
 (action
  (progn
   (chdir
    skia
    (progn
     (ignore-outputs
      (run python3 tools/git-sync-deps))
     (ignore-outputs
      (bash
       "bin/gn gen out/%{read-lines:os.txt}/%{read-lines:arch.txt} --args='%{read-lines:../config/gn_args.txt}'"))))
   (run bash -c "scripts/build-vendor.sh"))))
