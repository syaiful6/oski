(rule
 (targets gn_args.txt)
 (deps
  (:discover ../config/discover.exe))
 (action
  (run %{discover})))

(rule
 (targets os.txt)
 (action
  (with-stdout-to
   %{targets}
   (run sh -c "uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/mac/'"))))

(rule
 (targets arch.txt)
 (action
  (with-stdout-to
   %{targets}
   (run sh -c "uname -m | sed 's/x86_64/x64/;s/arm64/arm64/'"))))

(rule
 (targets lib_ext.txt)
 (deps os.txt)
 (action
  (with-stdout-to
   %{targets}
   (run
    sh
    -c
    "if [ $(cat os.txt) = windows ]; then echo lib; else echo a; fi"))))

(rule
 (targets
  (dir prefix))
 (deps
  (source_tree skia)
  gn_args.txt
  os.txt
  arch.txt)
 (action
  (progn
   (chdir
    skia
    (progn
     (ignore-outputs
      (run python3 tools/git-sync-deps))
     (ignore-outputs
      (bash
       "bin/gn gen out/%{read-lines:os.txt}/%{read-lines:arch.txt} --args='%{read-lines:gn_args.txt}'"))
     (run
      ninja
      -C
      out/%{read-lines:os.txt}/%{read-lines:arch.txt}
      skia
      modules/skottie
      modules/svg)))
   (bash
    "mkdir -p prefix/lib && cp skia/out/%{read-lines:os.txt}/%{read-lines:arch.txt}/lib{skia,svg,skottie}.%{read-lines:lib_ext.txt} prefix/lib")
   (bash
    "mkdir -p prefix/include/c && cp -r skia/include/c/* prefix/include/c")
   (bash
    "mkdir -p prefix/include/svg && cp -r skia/modules/svg/include/* prefix/include/svg")
   (bash
    "mkdir -p prefix/include/skottie && cp -r skia/modules/skottie/include/* prefix/include/skottie"))))
