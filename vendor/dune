(rule
 (targets os.txt)
 (action
  (with-stdout-to
   %{targets}
   (run sh -c "uname -s | tr '[:upper:]' '[:lower:]' | sed 's/darwin/mac/'"))))

(rule
 (targets arch.txt)
 (action
  (with-stdout-to
   %{targets}
   (run sh -c "uname -m | sed 's/x86_64/x64/;s/arm64/arm64/'"))))

(rule
 (targets lib_ext.txt)
 (deps os.txt)
 (action
  (with-stdout-to
   %{targets}
   (run
    sh
    -c
    "if [ $(cat os.txt) = windows ]; then echo lib; else echo a; fi"))))

(rule
 (targets
  (dir prefix))
 (deps scripts/get-skia-prebuilt.sh)
 (enabled_if
  (= true %{env:USE_PREBUILT_SKIA=false}))
 (action
  (progn
   (ignore-outputs
    (run scripts/get-skia-prebuilt.sh)))))

(rule
 (targets
  (dir prefix))
 (deps
  (source_tree skia)
  os.txt
  arch.txt
  lib_ext.txt
  ../config/gn_args.txt
  scripts/compile-skia.sh
  DEPS)
 (enabled_if
  (= false %{env:USE_PREBUILT_SKIA=false}))
 (action
  (progn
   (ignore-outputs
    (run
     scripts/compile-skia.sh
     %{read-lines:os.txt}
     %{read-lines:arch.txt}
     %{read-lines:lib_ext.txt}
     ../config/gn_args.txt
     DEPS)))))
